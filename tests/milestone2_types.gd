extends "res://addons/GDBlueprints/tests/graph_functions.gd"

const Types = preload("res://addons/GDBlueprints/core/collection_types.gd")
const Variables = preload("res://addons/GDBlueprints/core/blueprint_variable_utils.gd")
const Pins = preload("res://addons/GDBlueprints/core/pin_type_registry.gd")
const Runtime = preload("res://addons/GDBlueprints/core/function_runtime.gd")

func _run() -> void:
	var enum_type := "Enum[Idle=0, Running=10]"
	check(Signature.parse("items: Array[int], counts: Dictionary[String, int], state: " + enum_type).error.is_empty(), "Generic/enum signature parsing")
	check(not Signature.parse("items: Array[Array[int]]").error.is_empty(), "Nested typed container accepted")
	check(Types.parse("Enum[A=1, B=1]").is_empty(), "Duplicate enum values accepted")
	check(Pins.compatible("Array[int]", "Array") and not Pins.compatible("Array[int]", "Array[float]"), "Container variance is unsafe")
	check(not Pins.compatible("int", enum_type), "Untyped integer may bypass enum pins")
	for record in [{"type":"Array[int]", "value":[1, 2]}, {"type":"Dictionary[String, float]", "value":{"score":1.5}}, {"type":enum_type, "value":10}]:
		var script := GDScript.new()
		script.source_code = "extends Node\n" + Variables.export_annotation(record.type) + "var value: %s = %s\n" % [Pins.variable_type(record.type), Variables.to_gdscript_value_literal(record.value, record.type)]
		check(script.reload() == OK, "Typed export failed: " + str(record.type))
		var node = script.new()
		check(node.value == record.value, "Typed default changed")
		if node.value is Array: check(node.value.get_typed_builtin() == TYPE_INT, "Array constraint was lost")
		if node.value is Dictionary: check(node.value.get_typed_value_builtin() == TYPE_FLOAT, "Dictionary constraint was lost")
		node.free()
	check(Variables.to_gdscript_value_literal(["wrong"], "Array[int]") == "GDBLUEPRINTS_INVALID_COLLECTION_DEFAULT", "Invalid initial value silently coerced")
	var f := Fixture.new()
	add(f, "entry", "FunctionEntry", signature("typed_copy", "items: Array[int]", "Array[int]", "saved: Array[int]"))
	add(f, "store", "SetFunctionLocal", {"local_name":"saved", "value":'_flow.function_arguments["typed_copy"]["items"]'})
	add(f, "return", "FunctionReturn", {"value":'_flow.function_locals["typed_copy"]["saved"]'})
	wire(f, "entry", "store")
	wire(f, "store", "return")
	add(f, "enum_entry", "FunctionEntry", signature("choose_state", "state: " + enum_type, enum_type))
	add(f, "enum_return", "FunctionReturn", {"value":'_flow.function_arguments["choose_state"]["state"]'})
	wire(f, "enum_entry", "enum_return")
	var owner := compile(f)
	if owner != null:
		var result := Runtime.invoke(owner, "typed_copy", [[2, 5]], "Array[int]", {})
		check(result.ok and result.result == [2, 5] and result.result.get_typed_builtin() == TYPE_INT, "Typed dispatch/local/return")
		check(owner.call("choose_state", 10) == 10, "Enum function return")
		check(not owner.call("_gdb_function_dispatch", "choose_state", [99], {}).ok, "Out-of-range enum passed internal dispatch")
		check(not Runtime.Dispatch.validation_error(owner, "typed_copy", [["bad"]]).is_empty(), "Bad collection reached native method")
		owner.free()
	f.dispose()
	var int_values: Array[int] = [1, 2]
	var widened: Variant = Types.converted(int_values, "Array[float]")
	check(widened.get_typed_builtin() == TYPE_FLOAT and widened == [1.0, 2.0], "Native typed-to-typed conversion")
	var panel := BlueprintPanel.new()
	root.add_child(panel)
	var target := Node.new()
	root.add_child(target)
	panel.current_node = target
	panel.variables_data.append({"name":"items", "type":"Array", "value":[], "exported":false})
	check(panel._apply_type_expression("Array[int]", 0, false).is_empty(), "Advanced type editor rejected valid declaration")
	var before: Dictionary = panel.variables_data[0].duplicate(true)
	check(not panel._apply_type_expression("Enum[A=0]", 0, false).is_empty() and panel.variables_data[0] == before, "Rejected type edit changed data")
	panel._save_variables_to_metadata()
	panel._load_variables_from_metadata()
	check(panel.variables_data[0].type == "Array[int]", "Typed variable metadata reload")
	panel.free()
	target.free()
	print("Milestone 2 type failures: ", failures)
	quit(0 if failures.is_empty() else 1)
