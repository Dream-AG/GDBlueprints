@tool
extends "res://addons/GDBlueprints/core/blueprint_node.gd"

## Connects a native Godot signal to a GDBlueprints Custom Event method.

func _init() -> void:
	super._init()
	brick_type = BrickType.ACTUATOR
	brick_name = "Connect Signal To Custom Event"

func _initialize_properties() -> void:
	properties = {
		"target":"self",
		"target_expression":"",
		"signal_name":"pressed",
		"event_name":"on_pressed",
		"forward_arguments":false,
		"disconnect":false
	}

func get_property_definitions() -> Array:
	return [
		{"name":"forward_arguments", "type":TYPE_BOOL, "default":false},
		{"name":"disconnect", "type":TYPE_BOOL, "default":false},
		{"name":"target", "type":TYPE_STRING, "default":"self", "blueprint_pin":true, "pin_type":"Object", "pin_label":"Target"},
		{"name":"signal_name", "type":TYPE_STRING, "default":"pressed", "blueprint_pin":false, "required":true, "required_label":"Signal Name"},
		{"name":"event_name", "type":TYPE_STRING, "default":"on_pressed", "blueprint_pin":false, "required":true, "required_label":"Custom Event"}
	]

func get_brick_info() -> Dictionary:
	return {
		"class":"ConnectSignalActuator",
		"name":"Connect Signal To Custom Event",
		"type":"actuator",
		"category":"Signals",
		"description":"Connects a Godot signal such as Button.pressed to a named Custom Event on this script.",
		"menu_order":1,
		"aliases":["Bind Event", "Bind Signal", "Connect Signal", "Event Dispatcher Bind", "Button Pressed"],
		"godot_term":"Godot/GDScript: target.signal.connect(Callable(self, \"event\"))"
	}

func get_tooltip_definitions() -> Dictionary:
	return {
		"_description":"Godot's native loose-coupling mechanism is Signals. Connect a signal from another object to a Custom Event generated by this Blueprint graph. Run this once, usually from Event BeginPlay.",
		"target":"Object that emits the signal, such as a Button.",
		"signal_name":"Native signal name, such as pressed, toggled, value_changed, timeout, or body_entered.",
		"event_name":"Name of a Custom Event in this Blueprint graph. Enable Forward Arguments to pass the signal values to a matching typed Custom Event or handwritten method. Leave it off for legacy no-argument events."
	}

func _target_expression() -> String:
	var expression := str(properties.get("target_expression", "")).strip_edges()
	if not expression.is_empty():
		return expression
	var target_text := str(properties.get("target", "self")).strip_edges()
	if target_text.is_empty() or target_text.to_lower() == "self":
		return "self"
	return "get_node_or_null(\"%s\")" % _gd_string(target_text)

func _event_identifier(value: String) -> String:
	var out := value.strip_edges().replace(" ", "_")
	var regex := RegEx.new()
	regex.compile("[^a-zA-Z0-9_]")
	out = regex.sub(out, "", true)
	if out.is_empty():
		out = "custom_event"
	if out.substr(0, 1).is_valid_int():
		out = "_" + out
	return out

func generate_ir(_node: Node, _chain_name: String) -> Dictionary:
	var code := 'preload("res://addons/GDBlueprints/core/signal_dispatch.gd").connect_event(%s, %s, self, %s, %s, %s)' % [_target_expression(), var_to_str(str(properties.signal_name)), var_to_str(preload("res://addons/GDBlueprints/core/event_signature.gd").event_identifier(str(properties.event_name))), str(properties.get("forward_arguments", false)), str(properties.get("disconnect", false))]
	return {"actuator":[{"op":"statement", "code":code}]}
